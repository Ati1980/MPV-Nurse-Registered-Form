rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 0: Global Safety Net - default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Hardened Helpers
    // ---------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'kku.tum@gmail.com';
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidStatusValue(val) {
      return val is string && val in [
        'ได้รับใบสมัครแล้ว',
        'อยู่ระหว่างตรวจสอบเอกสาร',
        'ผ่านการคัดกรองเบื้องต้น',
        'นัดหมายสัมภาษณ์'
      ];
    }

    // ---------------------------------------------------------
    // Nested Schema Validation Blueprints (Forms 1 - 5)
    // ---------------------------------------------------------
    function isValidPersonalInfo(p) {
      return p is map &&
        p.keys().hasAll([
          'title', 'fullNameTh', 'nicknameTh', 'fullNameEn', 'nicknameEn',
          'dateOfBirth', 'age', 'placeOfBirth', 'nationality', 'mobileNumber',
          'email', 'idCardOrPassport', 'lineId', 'permanentAddress',
          'permanentLandLine', 'presentAddress', 'presentLandLine', 'sameAsPermanent'
        ]) &&
        p.keys().hasOnly([
          'title', 'fullNameTh', 'nicknameTh', 'fullNameEn', 'nicknameEn',
          'dateOfBirth', 'age', 'placeOfBirth', 'nationality', 'mobileNumber',
          'email', 'idCardOrPassport', 'lineId', 'permanentAddress',
          'permanentLandLine', 'presentAddress', 'presentLandLine', 'sameAsPermanent'
        ]) &&
        isBoundedString(p.title, 1, 30) &&
        isBoundedString(p.fullNameTh, 1, 120) &&
        isBoundedString(p.nicknameTh, 0, 60) &&
        isBoundedString(p.fullNameEn, 1, 120) &&
        isBoundedString(p.nicknameEn, 0, 60) &&
        isBoundedString(p.dateOfBirth, 4, 30) &&
        isBoundedString(p.age, 1, 10) &&
        isBoundedString(p.placeOfBirth, 1, 120) &&
        isBoundedString(p.nationality, 1, 60) &&
        isBoundedString(p.mobileNumber, 9, 20) &&
        isBoundedString(p.email, 3, 150) &&
        isBoundedString(p.idCardOrPassport, 6, 30) &&
        isBoundedString(p.lineId, 0, 80) &&
        isBoundedString(p.permanentAddress, 1, 500) &&
        isBoundedString(p.permanentLandLine, 0, 30) &&
        isBoundedString(p.presentAddress, 1, 500) &&
        isBoundedString(p.presentLandLine, 0, 30) &&
        p.sameAsPermanent is bool;
    }

    function isValidWorkExperienceItem(item) {
      return item is map &&
        item.keys().hasAll([
          'id', 'fromMonthYear', 'toMonthYear', 'company', 'position',
          'scopeOfResponsibility', 'salary', 'otherIncome', 'reasonForLeaving'
        ]) &&
        item.keys().hasOnly([
          'id', 'fromMonthYear', 'toMonthYear', 'company', 'position',
          'scopeOfResponsibility', 'salary', 'otherIncome', 'reasonForLeaving'
        ]) &&
        isBoundedString(item.id, 1, 80) &&
        isBoundedString(item.fromMonthYear, 0, 40) &&
        isBoundedString(item.toMonthYear, 0, 40) &&
        isBoundedString(item.company, 0, 150) &&
        isBoundedString(item.position, 0, 120) &&
        isBoundedString(item.scopeOfResponsibility, 0, 1000) &&
        isBoundedString(item.salary, 0, 40) &&
        isBoundedString(item.otherIncome, 0, 40) &&
        isBoundedString(item.reasonForLeaving, 0, 300);
    }

    function isValidEducationItem(item) {
      return item is map &&
        item.keys().hasAll([
          'levelKey', 'levelLabel', 'institute', 'degree',
          'major', 'gpa', 'fromYear', 'toYear'
        ]) &&
        item.keys().hasOnly([
          'levelKey', 'levelLabel', 'institute', 'degree',
          'major', 'gpa', 'fromYear', 'toYear'
        ]) &&
        isBoundedString(item.levelKey, 1, 30) &&
        isBoundedString(item.levelLabel, 1, 80) &&
        isBoundedString(item.institute, 0, 150) &&
        isBoundedString(item.degree, 0, 120) &&
        isBoundedString(item.major, 0, 120) &&
        isBoundedString(item.gpa, 0, 20) &&
        isBoundedString(item.fromYear, 0, 20) &&
        isBoundedString(item.toYear, 0, 20);
    }

    function isValidNursingQualification(n) {
      return n is map &&
        n.keys().hasAll([
          'licenseNumber', 'licenseIssueDate', 'licenseExpiryDate',
          'occupationalHealthTrained', 'occupationalHealthHours',
          'blsAclsCertified', 'shiftWorkReady', 'availableStartDate',
          'expectedSalary', 'clinicalSkillsNote'
        ]) &&
        n.keys().hasOnly([
          'licenseNumber', 'licenseIssueDate', 'licenseExpiryDate',
          'occupationalHealthTrained', 'occupationalHealthHours',
          'blsAclsCertified', 'shiftWorkReady', 'availableStartDate',
          'expectedSalary', 'clinicalSkillsNote'
        ]) &&
        isBoundedString(n.licenseNumber, 0, 60) &&
        isBoundedString(n.licenseIssueDate, 0, 30) &&
        isBoundedString(n.licenseExpiryDate, 0, 30) &&
        n.occupationalHealthTrained is bool &&
        isBoundedString(n.occupationalHealthHours, 0, 30) &&
        n.blsAclsCertified is bool &&
        n.shiftWorkReady is bool &&
        isBoundedString(n.availableStartDate, 0, 30) &&
        isBoundedString(n.expectedSalary, 0, 30) &&
        isBoundedString(n.clinicalSkillsNote, 0, 1500);
    }

    function isValidEmergencyContact(e) {
      return e is map &&
        e.keys().hasAll(['fullName', 'relationship', 'address', 'mobilePhone', 'landLine']) &&
        e.keys().hasOnly(['fullName', 'relationship', 'address', 'mobilePhone', 'landLine']) &&
        isBoundedString(e.fullName, 0, 120) &&
        isBoundedString(e.relationship, 0, 60) &&
        isBoundedString(e.address, 0, 500) &&
        isBoundedString(e.mobilePhone, 0, 20) &&
        isBoundedString(e.landLine, 0, 30);
    }

    function isValidDocumentMetadata(d) {
      return d is map &&
        d.keys().hasAll([
          'id', 'slotKey', 'slotLabel', 'fileName', 'mimeType', 'sizeBytes', 'uploadedAt'
        ]) &&
        d.keys().hasOnly([
          'id', 'slotKey', 'slotLabel', 'fileName', 'mimeType', 'sizeBytes', 'uploadedAt', 'fileUrl'
        ]) &&
        isBoundedString(d.id, 1, 100) &&
        isBoundedString(d.slotKey, 1, 40) &&
        isBoundedString(d.slotLabel, 1, 150) &&
        isBoundedString(d.fileName, 1, 255) &&
        isBoundedString(d.mimeType, 1, 100) &&
        d.sizeBytes is number && d.sizeBytes >= 0 && d.sizeBytes <= 15000000 &&
        isBoundedString(d.uploadedAt, 10, 64) &&
        (!('fileUrl' in d) || isBoundedString(d.fileUrl, 1, 500));
    }

    function isValidNurseRegistration(data) {
      return data is map &&
        data.keys().hasAll([
          'applicationId', 'status', 'submittedAt', 'createdAt', 'updatedAt',
          'hasNoWorkExperience', 'pdpaAccepted', 'truthfulnessAccepted',
          'personalInfo', 'workExperiences', 'educationBackground',
          'nursingQualification', 'emergencyContact', 'documents'
        ]) &&
        data.keys().hasOnly([
          'applicationId', 'status', 'submittedAt', 'createdAt', 'updatedAt',
          'hrNote', 'hasNoWorkExperience', 'pdpaAccepted', 'truthfulnessAccepted',
          'personalInfo', 'workExperiences', 'educationBackground',
          'nursingQualification', 'emergencyContact', 'documents'
        ]) &&
        isValidId(data.applicationId) &&
        data.applicationId.size() >= 5 &&
        data.applicationId.size() <= 64 &&
        isValidStatusValue(data.status) &&
        isBoundedString(data.submittedAt, 10, 64) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        (!('hrNote' in data) || isBoundedString(data.hrNote, 0, 1000)) &&
        data.hasNoWorkExperience is bool &&
        data.pdpaAccepted is bool &&
        data.truthfulnessAccepted is bool &&
        isValidPersonalInfo(data.personalInfo) &&
        data.workExperiences is list &&
        data.workExperiences.size() <= 15 &&
        (data.workExperiences.size() == 0 || isValidWorkExperienceItem(data.workExperiences[0])) &&
        data.educationBackground is list &&
        data.educationBackground.size() >= 1 &&
        data.educationBackground.size() <= 8 &&
        isValidEducationItem(data.educationBackground[0]) &&
        isValidNursingQualification(data.nursingQualification) &&
        isValidEmergencyContact(data.emergencyContact) &&
        data.documents is list &&
        data.documents.size() <= 10 &&
        (data.documents.size() == 0 || isValidDocumentMetadata(data.documents[0]));
    }

    function isValidNurseRegistrationStatus(data) {
      return data is map &&
        data.keys().hasAll([
          'applicationId', 'status', 'submittedAt', 'mobileHash', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'applicationId', 'status', 'submittedAt', 'mobileHash', 'hrNote', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.applicationId) &&
        data.applicationId.size() >= 5 &&
        data.applicationId.size() <= 64 &&
        isValidStatusValue(data.status) &&
        isBoundedString(data.submittedAt, 10, 64) &&
        data.mobileHash is string &&
        data.mobileHash.size() == 64 &&
        data.mobileHash.matches('^[a-f0-9]{64}$') &&
        (!('hrNote' in data) || isBoundedString(data.hrNote, 0, 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRegistrationFile(f) {
      return f is map &&
        f.keys().hasAll([
          'id', 'applicationId', 'slotKey', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'createdAt'
        ]) &&
        f.keys().hasOnly([
          'id', 'applicationId', 'slotKey', 'fileName', 'mimeType', 'sizeBytes', 'dataUrl', 'chunkIndex', 'chunkCount', 'createdAt'
        ]) &&
        isValidId(f.id) &&
        f.id.size() <= 120 &&
        isValidId(f.applicationId) &&
        f.applicationId.size() >= 5 &&
        f.applicationId.size() <= 64 &&
        isBoundedString(f.slotKey, 1, 40) &&
        isBoundedString(f.fileName, 1, 255) &&
        isBoundedString(f.mimeType, 1, 100) &&
        f.sizeBytes is number && f.sizeBytes >= 0 && f.sizeBytes <= 15000000 &&
        isBoundedString(f.dataUrl, 1, 900000) &&
        (!('chunkIndex' in f) || (f.chunkIndex is number && f.chunkIndex >= 0 && f.chunkIndex <= 50)) &&
        (!('chunkCount' in f) || (f.chunkCount is number && f.chunkCount >= 1 && f.chunkCount <= 50)) &&
        f.createdAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data is map &&
        data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        isValidId(data.uid) &&
        isBoundedString(data.email, 3, 150) &&
        data.createdAt is timestamp;
    }

    // ---------------------------------------------------------
    // Collection: /nurse_register/{applicationId}
    // ---------------------------------------------------------
    match /nurse_register/{applicationId} {
      allow get: if isValidId(applicationId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(applicationId) &&
        isValidNurseRegistration(incoming()) &&
        incoming().applicationId == applicationId &&
        incoming().status == 'ได้รับใบสมัครแล้ว' &&
        incoming().pdpaAccepted == true &&
        incoming().truthfulnessAccepted == true &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(applicationId) &&
        isValidNurseRegistration(incoming()) &&
        isAdmin() &&
        incoming().applicationId == existing().applicationId &&
        incoming().submittedAt == existing().submittedAt &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hrNote', 'updatedAt']);
      allow delete: if isValidId(applicationId) && isAdmin();

      // Subcollection: /nurse_register/{applicationId}/files/{docId}
      match /files/{docId} {
        allow get: if isValidId(applicationId) &&
          isValidId(docId) &&
          isAdmin() &&
          exists(/databases/$(database)/documents/nurse_register/$(applicationId));
        allow list: if isBootstrappedAdmin();
        allow create: if isValidId(applicationId) &&
          isValidId(docId) &&
          isValidRegistrationFile(incoming()) &&
          incoming().id == docId &&
          incoming().applicationId == applicationId &&
          incoming().createdAt == request.time &&
          (
            exists(/databases/$(database)/documents/nurse_register/$(applicationId)) ||
            existsAfter(/databases/$(database)/documents/nurse_register/$(applicationId))
          );
        allow update: if false;
        allow delete: if isValidId(applicationId) &&
          isValidId(docId) &&
          isAdmin() &&
          exists(/databases/$(database)/documents/nurse_register/$(applicationId));
      }
    }

    // ---------------------------------------------------------
    // Collection: /nurse_register_status/{applicationId} (Non-PII)
    // ---------------------------------------------------------
    match /nurse_register_status/{applicationId} {
      allow get: if isValidId(applicationId);
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(applicationId) &&
        isValidNurseRegistrationStatus(incoming()) &&
        incoming().applicationId == applicationId &&
        incoming().status == 'ได้รับใบสมัครแล้ว' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/nurse_register/$(applicationId));
      allow update: if isValidId(applicationId) &&
        isValidNurseRegistrationStatus(incoming()) &&
        isAdmin() &&
        incoming().applicationId == existing().applicationId &&
        incoming().submittedAt == existing().submittedAt &&
        incoming().mobileHash == existing().mobileHash &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hrNote', 'updatedAt']);
      allow delete: if isValidId(applicationId) && isAdmin();
    }

    // ---------------------------------------------------------
    // Collection: /admins/{userId}
    // ---------------------------------------------------------
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(userId) &&
        isValidAdminUser(incoming()) &&
        isBootstrappedAdmin() &&
        incoming().uid == userId &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
